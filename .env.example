# Telegram (use a dedicated bot)
ACCOUNT_BOT_TELEGRAM_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
ACCOUNT_BOT_FINGERPRINT_PEPPER=

# Kiwoom read-only account sources
KIWOOM_MAIN_APPKEY=
KIWOOM_MAIN_SECRET=
KIWOOM_ACCUM_APPKEY=
KIWOOM_ACCUM_SECRET=
KIWOOM_API_BASE_URL=
KIWOOM_SNAPSHOT_PATH=

# Toss Open API (optional until activated)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=
TOSS_SNAPSHOT_PATH=

# Meritz normalized local sources. A directory resolves to the named JSON file.
MERITZ_SNAPSHOT_PATH=meritz_snapshot/account
MERITZ_ACCUMUL_SNAPSHOT_PATH=meritz_snapshot/accoumulate

# Optional alternate dotenv path. A CLI --env-file argument has priority.
ACCOUNT_BOT_ENV_FILE=
ACCOUNT_BOT_DATA_DIR=data
ACCOUNT_BOT_LOG_DIR=logs
ACCOUNT_BOT_REPORT_DIR=reports
ACCOUNT_BOT_CACHE_DIR=cache
DATABASE_URL=sqlite+aiosqlite:///data/account_bot.db
# Separate explicit local DB for the web dashboard; never point tests at an operational DB.
ACCOUNT_BOT_WEB_DATABASE_URL=sqlite+aiosqlite:///data/account_bot_web.db
# Public Yahoo/yfinance price, USD/KRW and adjusted Total Return enrichment.
ACCOUNT_BOT_WEB_LIVE_MARKET_DATA=true
SQLITE_BUSY_TIMEOUT_MS=5000
ACCOUNT_BOT_TIMEZONE=Asia/Seoul
SCHEDULER_ENABLED=true
DAILY_REPORT_TIME=08:00
WEEKLY_REPORT_TIME=09:00
WEEKLY_REPORT_WEEKDAY=5

COMPANY_WEIGHT_FUNDAMENTAL=0.35
COMPANY_WEIGHT_VALUATION=0.25
COMPANY_WEIGHT_GROWTH=0.20
COMPANY_WEIGHT_MOAT=0.10
COMPANY_WEIGHT_RISK=0.10
FINAL_WEIGHT_COMPANY=0.70
FINAL_WEIGHT_PORTFOLIO=0.30
